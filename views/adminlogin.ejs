<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Admin Login</title>
</head>
<body class="min-h-screen bg-[#f7f5ef] text-[#24352d]">

    <%- include('includes/nav.ejs') %>

    <div class="mx-auto mt-12 max-w-sm text-center">
        <h1 class="text-3xl font-bold">Welcome, Admin</h1>
        <p class="mt-2 text-gray-500">Login to manage your bookstore</p>
    </div>

    <form action="/admin/login" method="POST"
        class="mx-auto mt-6 max-w-sm rounded-2xl bg-white p-8 shadow-lg">

        <h2 class="mb-6 text-center text-xl font-bold">Admin Panel</h2>

        <label class="font-medium">Username</label>
        <input type="text" name="username" required
            class="mb-4 mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 outline-none focus:border-[#315b43]">

        <label class="font-medium">Password</label>
        <input type="password" name="password" required
            class="mb-6 mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 outline-none focus:border-[#315b43]">

        <button type="submit"
            class="w-full rounded-lg bg-[#315b43] py-2.5 font-medium text-white hover:bg-[#244832]">
            Login
        </button>

    </form>

</body>
</html>