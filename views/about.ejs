<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-[#f7f5ef] text-[#24352d]">

    <%- include('includes/nav.ejs') %>

    <section class="max-w-5xl mx-auto px-5 py-12 text-center">
        <h1 class="text-4xl font-bold">About Our Bookstore</h1>
        <p class="mt-4 max-w-2xl mx-auto text-gray-600">
            Welcome to our bookstore, a place where readers can discover
            new stories, ideas and knowledge.
        </p>
    </section>

    <section class="max-w-5xl mx-auto px-5 pb-10">
        <div class="bg-white rounded-2xl p-7 md:flex items-center gap-8 shadow-sm">
            <div class="md:w-1/2">
                <img src="/uploads/img1.jpg" alt="Bookstore"
                    class="w-full h-72 object-cover rounded-xl">
            </div>

            <div class="md:w-1/2 mt-6 md:mt-0">
                <h2 class="text-3xl font-bold">A Place for Every Reader</h2>
                <p class="mt-4 text-gray-600">
                    Our bookstore brings together books from different
                    categories for students, readers and book lovers.
                </p>
                <p class="mt-3 text-gray-600">
                    We believe books help us learn, improve our knowledge
                    and see the world in a better way.
                </p>
            </div>
        </div>
    </section>

    <section class="max-w-5xl mx-auto px-5 pb-12">
        <h2 class="text-3xl font-bold text-center mb-6">Why Choose Us?</h2>

        <div class="grid md:grid-cols-3 gap-5">
            <div class="bg-white p-6 rounded-xl text-center shadow-sm">
                <h3 class="text-xl font-bold">Wide Collection</h3>
                <p class="mt-2 text-gray-600">
                    Explore books from different categories.
                </p>
            </div>

            <div class="bg-white p-6 rounded-xl text-center shadow-sm">
                <h3 class="text-xl font-bold">Easy to Explore</h3>
                <p class="mt-2 text-gray-600">
                    Find and explore books easily.
                </p>
            </div>

            <div class="bg-white p-6 rounded-xl text-center shadow-sm">
                <h3 class="text-xl font-bold">For Everyone</h3>
                <p class="mt-2 text-gray-600">
                    Books for students and every kind of reader.
                </p>
            </div>
        </div>
    </section>
    <footer class="bg-[#1d3025] py-5 text-center text-sm text-white/60">
        Read. Learn. Grow. © The Book Store
    </footer>

</body>
</html>

