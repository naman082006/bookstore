<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#24352d">
    <title>Your Cart | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-[#f7f5ef] text-[#24352d]">

    <%- include('includes/nav.ejs') %>

    <main class="mx-auto max-w-7xl px-5 py-10 sm:px-8">

        <div class="mb-5 flex justify-end">
            <a href="/orders" class="inline-flex items-center gap-2 rounded-xl bg-[#315b43] px-5 py-3 font-semibold text-white shadow-sm transition hover:bg-[#24352d]">
                📦 My Orders →
            </a>
        </div>

        <div class="mb-9 rounded-2xl bg-[#24352d] px-6 py-10 text-center text-white sm:py-12">
            <p class="text-sm font-semibold uppercase tracking-[4px] text-[#d8bd82]">Your Books</p>
            <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Your Cart</h1>
            <p class="mt-3 text-sm text-white/70 sm:text-base">Review your books before placing your order.</p>
            <div class="mx-auto mt-5 h-1 w-16 rounded-full bg-[#d8bd82]"></div>
        </div>

        <% if (justAdded) { %>
            <div class="mb-5 rounded-xl border border-[#cbdcc5] bg-[#edf4e9] px-5 py-3 text-sm font-medium text-[#315b43]">
                ✓ Book added to your cart. Happy reading!
            </div>
        <% } %>

        <% if (attemptedEmptyCheckout) { %>
            <div class="mb-5 rounded-xl border border-[#ead9ae] bg-[#fff8e7] px-5 py-3 text-sm text-[#765b25]">
                Add a book to your cart before checking out.
            </div>
        <% } %>

        <% if (removedUnavailable) { %>
            <div class="mb-5 rounded-xl border border-[#ead9ae] bg-[#fff8e7] px-5 py-3 text-sm text-[#765b25]">
                A book that is no longer available was removed from your cart.
            </div>
        <% } %>

        <% if (items.length) { %>

            <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-3">

                <section class="space-y-5 lg:col-span-2" aria-label="Books in your cart">

                    <% items.forEach((item) => { %>

                        <article class="cart-item overflow-hidden rounded-2xl border border-[#e3e1d7] bg-gradient-to-r from-white to-[#f4f5ee] shadow-sm transition duration-300 hover:border-[#c7d3c1] hover:shadow-md">

                            <div class="flex flex-col sm:flex-row">

                                <div class="flex h-52 items-center justify-center bg-[#eeece3] p-5 sm:h-auto sm:min-h-56 sm:w-44 sm:shrink-0">
                                    <% if (item.book.image) { %>
                                        <img
                                            src="<%= item.book.image.startsWith('/uploads/') ? item.book.image : '/uploads/' + item.book.image %>"
                                            alt="Cover of <%= item.book.title %>"
                                            class="h-full max-h-48 w-full object-contain"
                                            onerror="this.hidden=true;this.nextElementSibling.hidden=false"
                                        >
                                    <% } %>

                                    <span <% if (item.book.image) { %>hidden<% } %> class="text-center text-sm text-gray-400">
                                        📚<br>Cover unavailable
                                    </span>
                                </div>

                                <div class="flex flex-1 flex-col justify-between gap-5 p-5 sm:p-6">

                                    <div>
                                        <span class="inline-block rounded-full bg-[#e8eee3] px-3 py-1 text-xs font-semibold text-[#315b43]">
                                            <%= item.book.category || 'Featured' %>
                                        </span>

                                        <h2 class="mt-3 text-xl font-bold leading-7 text-[#24352d]">
                                            <%= item.book.title %>
                                        </h2>

                                        <p class="mt-1 text-sm text-gray-500">
                                            By <%= item.book.author || 'Unknown author' %>
                                        </p>

                                        <p class="mt-3 text-lg font-bold text-[#315b43]">
                                            ₹<%= Number(item.book.price).toLocaleString('en-IN') %>
                                        </p>
                                    </div>

                                    <div class="flex flex-wrap items-end justify-between gap-4 border-t border-dashed border-[#d9dfd5] pt-4">

                                        <form class="quantity-form flex flex-wrap items-end gap-2"
                                              action="/cart/update/<%= item.book._id %>"
                                              method="POST">

                                            <div>
                                                <label for="qty-<%= item.book._id %>" class="mb-1 block text-xs font-semibold text-gray-500">
                                                    Quantity
                                                </label>

                                                <div class="flex items-center gap-1">
                                                    <button type="button"
                                                            onclick="changeQuantity(this, -1)"
                                                            class="h-10 w-9 rounded-lg border border-[#d8ddd8] bg-white text-lg hover:bg-[#e8eee3]">
                                                        −
                                                    </button>

                                                    <input
                                                        id="qty-<%= item.book._id %>"
                                                        type="number"
                                                        name="quantity"
                                                        value="<%= item.quantity %>"
                                                        min="1"
                                                        max="20"
                                                        required
                                                        data-price="<%= item.book.price %>"
                                                        oninput="quantityChanged(this)"
                                                        class="quantity-input w-16 rounded-lg border border-[#d8ddd8] bg-white px-2 py-2.5 text-center font-medium outline-none focus:border-[#315b43] focus:ring-2 focus:ring-[#315b43]/10"
                                                    >

                                                    <button type="button"
                                                            onclick="changeQuantity(this, 1)"
                                                            class="h-10 w-9 rounded-lg border border-[#d8ddd8] bg-white text-lg hover:bg-[#e8eee3]">
                                                        +
                                                    </button>
                                                </div>
                                            </div>

                                            <button type="submit"
                                                    class="hidden">
                                                Update
                                            </button>
                                        </form>

                                        <div class="text-right">
                                            <p class="text-xs font-medium uppercase tracking-wider text-gray-400">
                                                Subtotal
                                            </p>

                                            <p class="item-subtotal mt-1 text-xl font-bold text-[#24352d]">
                                                ₹<%= Number(item.lineTotal).toLocaleString('en-IN') %>
                                            </p>

                                            <form action="/cart/remove/<%= item.book._id %>" method="POST">
                                                <button type="submit" class="mt-2 text-sm font-medium text-red-500 transition hover:text-red-700 hover:underline">
                                                    Remove
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </article>

                    <% }) %>

                    <a href="/books" class="inline-flex items-center gap-2 py-2 font-semibold text-[#315b43] transition hover:text-[#78966f]">
                        <span>←</span> Continue Shopping
                    </a>

                </section>

                <aside class="rounded-2xl border border-[#e3e1d7] bg-white p-6 shadow-sm lg:sticky lg:top-6">

                    <p class="text-xs font-bold tracking-[3px] text-[#a1844b]">ORDER SUMMARY</p>
                    <h2 class="mt-2 text-2xl font-bold">Your Order</h2>

                    <div class="my-6 space-y-4 border-b border-dashed border-[#d9dfd5] pb-5">
                        <div class="flex items-center justify-between gap-3 text-sm">
                            <span class="text-gray-500">
                                <%= items.length %> <%= items.length === 1 ? 'book' : 'books' %>
                            </span>
                            <span id="summarySubtotal" class="font-semibold text-[#24352d]">
                                ₹<%= Number(total).toLocaleString('en-IN') %>
                            </span>
                        </div>

                        <div class="flex items-start justify-between gap-3 text-sm">
                            <span class="text-gray-500">Delivery</span>
                            <span class="text-right font-medium text-[#315b43]">Confirmed with order</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between gap-3">
                        <span class="text-lg font-bold">Total</span>
                        <strong id="cartTotal" class="text-2xl font-bold text-[#315b43]">
                            ₹<%= Number(total).toLocaleString('en-IN') %>
                        </strong>
                    </div>

                    <a href="/checkout" class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#315b43] px-4 py-3.5 text-center font-semibold text-white shadow-sm transition hover:bg-[#24352d] hover:shadow-md">
                        Continue to Checkout <span>→</span>
                    </a>

                    <div class="mt-4 rounded-xl bg-[#f1f4ed] p-4 text-center">
                        <p class="text-sm font-semibold text-[#315b43]">Cash on Delivery</p>
                        <p class="mt-1 text-xs leading-5 text-gray-500">Pay when your books arrive at your doorstep.</p>
                    </div>

                    <p class="mt-5 text-center text-xs text-gray-400">Thank you for shopping with us!</p>

                </aside>

            </div>

        <% } else { %>

            <section class="rounded-2xl border border-[#e3e1d7] bg-gradient-to-b from-white to-[#f0f3eb] px-5 py-16 text-center shadow-sm">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#e2eadc] text-4xl">📚</div>
                <h2 class="mt-6 text-2xl font-bold text-[#24352d]">Your Cart Is Empty</h2>
                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500">
                    Looks like you haven't added any books yet. Explore our collection and find your next favourite read.
                </p>
                <a href="/categories" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-[#315b43] px-7 py-3 font-semibold text-white shadow-sm transition hover:bg-[#24352d] hover:shadow-md">
                    Browse Books <span>→</span>
                </a>
            </section>

        <% } %>

    </main>

    <footer class="bg-[#1d3025] py-5 text-center text-sm text-white/60">
        Read. Learn. Grow. © The Book Store
    </footer>

    <script>
        let quantityTimer;

        function formatPrice(amount) {
            return Number(amount).toLocaleString('en-IN', {
                maximumFractionDigits: 2
            });
        }

        function updateCartTotals() {
            let total = 0;

            document.querySelectorAll('.cart-item').forEach(item => {
                const input = item.querySelector('.quantity-input');
                const price = Number(input.dataset.price) || 0;
                const quantity = Math.max(1, Number(input.value) || 1);
                const subtotal = price * quantity;

                item.querySelector('.item-subtotal').textContent =
                    '₹' + formatPrice(subtotal);

                total += subtotal;
            });

            document.getElementById('summarySubtotal').textContent =
                '₹' + formatPrice(total);

            document.getElementById('cartTotal').textContent =
                '₹' + formatPrice(total);
        }

        function quantityChanged(input) {
            if (input.value === '') return;

            let quantity = Number(input.value);

            if (quantity > 20) {
                quantity = 20;
                input.value = 20;
            }

            if (quantity < 1) {
                quantity = 1;
                input.value = 1;
            }

            updateCartTotals();

            clearTimeout(quantityTimer);

            quantityTimer = setTimeout(() => {
                input.closest('.quantity-form').requestSubmit();
            }, 600);
        }

        function changeQuantity(button, amount) {
            const input = button.parentElement.querySelector('.quantity-input');
            const current = Number(input.value) || 1;
            const next = Math.max(1, Math.min(20, current + amount));

            input.value = next;
            quantityChanged(input);
        }

        document.querySelectorAll('.quantity-form').forEach(form => {
            form.addEventListener('submit', () => {
                clearTimeout(quantityTimer);
            });
        });
    </script>

</body>
</html>