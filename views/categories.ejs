
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-[#f7f5ef] text-gray-800">
    <%- include('includes/nav.ejs') %>

    <div class="mx-auto max-w-7xl px-5 py-8">
        <div class="mb-8 text-center">
            <h1 class="text-4xl font-bold text-[#24352d] md:text-5xl">
                Book Categories
            </h1>
            <p class="mt-2 text-gray-500">
                Explore books from different categories
            </p>
        </div>

        <div class="mb-9 flex flex-wrap justify-center gap-3">
            <a href="/categories" class="rounded-full bg-[#315b43] px-5 py-2 font-medium text-white transition hover:bg-[#244832]">
                All
            </a>

            <% categories.forEach(category => { %>
                <a href="/categories/<%= encodeURIComponent(category) %>"
                    class="rounded-full border border-[#d8ddd8] bg-white px-5 py-2 font-medium text-gray-700 transition hover:border-[#315b43] hover:bg-[#315b43] hover:text-white">
                    <%= category %>
                </a>
            <% }) %>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <% books.forEach(book => { %>
                <div class="overflow-hidden rounded-2xl border border-[#e2e2dc] bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

                    <% if (book.image) { %>
                        <img
                            src="<%= book.image.startsWith('/uploads/') ? book.image : '/uploads/' + book.image %>"
                            alt="<%= book.title %>"
                           class="h-64 w-full bg-white object-contain px-3 py-4"
                            loading="lazy"
                        >
                    <% } else { %>
                        <div class="flex h-64 items-center justify-center bg-[#eef3ed] text-gray-400">
                            No Image Available
                        </div>
                    <% } %>

                    <div class="h-1 bg-gradient-to-r from-[#315b43] via-[#78966f] to-[#d0ad6f]"></div>

                    <div class="p-4">
                        <h2 class="mb-2 text-lg font-bold text-[#24352d]">
                            <%= book.title %>
                        </h2>

                        <p class="text-xs text-gray-400">Author</p>
                        <p class="mb-2 text-sm font-medium text-gray-700">
                            <%= book.author %>
                        </p>

                        <p class="text-xs text-gray-400">Price</p>
                        <p class="mb-2 text-lg font-bold text-[#315b43]">
                            ₹<%= book.price %>
                        </p>

                        <p class="text-xs text-gray-400">Category</p>
                        <span class="mt-1 inline-block rounded-full bg-[#eef3ed] px-3 py-1 text-xs font-medium text-[#315b43]">
                            <%= book.category %>
                        </span>

                        <form action="/cart/add/<%= book._id %>" method="POST" class="mt-3">
                            <button type="submit" class="w-full rounded-xl bg-[#315b43] py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#244832] hover:shadow-md">
                                🛒 Add to Cart
                            </button>
                        </form>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <footer class="mt-8 bg-[#1d3025] py-5 text-center text-sm text-white/60">
        Read. Learn. Grow. © The Book Store
    </footer>
</body>
</html>
