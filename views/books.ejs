<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Books | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex flex-col bg-[#f7f5ef] text-[#24352d] antialiased">

    <%- include('includes/nav.ejs') %>

    <h1 class="mt-8 mb-6 text-center font-serif text-3xl font-bold">
        Our Books
    </h1>

    <% if (isAdmin) { %>
        <div class="mb-6 flex flex-wrap justify-center gap-3">
            <a href="/books/new"
               class="rounded-lg bg-[#315b43] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#244832]">
                + Add New Book
            </a>

            <a href="/admin/logout"
               class="rounded-lg bg-red-500 px-5 py-2 text-sm font-semibold text-white transition hover:bg-red-600">
                Logout
            </a>
        </div>
    <% } %>

    <main class="mx-auto w-full max-w-7xl flex-1 px-5 pb-12">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">

            <% books.forEach(book => { %>

                <div class="overflow-hidden rounded-xl border border-[#d9dfd5] bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-[#b9c9b6] hover:shadow-lg">

                    <% if (book.image) { %>
                        <img
                            src="<%= book.image.startsWith('/uploads/') ? book.image : '/uploads/' + book.image %>"
                            alt="<%= book.title %>"
                            class="h-40 w-full bg-[#eeece3] object-contain p-3"
                            loading="lazy">
                    <% } else { %>
                        <div class="flex h-40 items-center justify-center bg-[#eef3ed] text-sm text-gray-400">
                            No Image Available
                        </div>
                    <% } %>

                    <div class="p-4">

                        <h2 class="mb-3 line-clamp-2 text-lg font-bold">
                            <%= book.title %>
                        </h2>

                        <div class="space-y-2 text-sm">

                            <p>
                                <span class="text-gray-500">Author:</span>
                                <span class="font-medium"><%= book.author %></span>
                            </p>

                            <p>
                                <span class="text-gray-500">Price:</span>
                                <span class="font-bold text-[#315b43]">
                                    ₹<%= book.price %>
                                </span>
                            </p>

                            <p>
                                <span class="text-gray-500">Category:</span>
                                <span class="ml-1 inline-block rounded-full bg-[#eef3ed] px-2.5 py-1 text-xs font-medium text-[#315b43]">
                                    <%= book.category %>
                                </span>
                            </p>

                            <a
                                href="https://www.google.com/search?q=<%= encodeURIComponent(book.title) %>"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-4 block w-full rounded-lg bg-[#315b43] py-2 text-center text-sm font-semibold text-white transition hover:bg-[#244832]">
                                View Book →
                            </a>

                        </div>

                        <% if (isAdmin) { %>
                            <div class="mt-4 flex gap-2">

                                <form action="/books/delete/<%= book._id %>" method="POST"
                                      onsubmit="return confirm('Are you sure you want to delete this book?')">
                                    <button type="submit"
                                            class="rounded-lg bg-red-500 px-4 py-2 text-sm font-medium text-white transition hover:bg-red-600">
                                        Delete
                                    </button>
                                </form>

                                <form action="/books/edit/<%= book._id %>" method="GET">
                                    <button type="submit"
                                            class="rounded-lg bg-blue-500 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-600">
                                        Edit
                                    </button>
                                </form>

                            </div>
                        <% } %>

                    </div>
                </div>

            <% }) %>

        </div>
    </main>

    <footer class="mt-auto bg-[#1d3025] py-5 text-center text-sm text-white/70">
        Read. Learn. Grow. © The Book Store
    </footer>

</body>
</html>
