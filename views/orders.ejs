<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#24352d">
    <title>My Orders | The Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex flex-col bg-[#f7f5ef] text-[#24352d] antialiased">

    <%- include('includes/nav.ejs') %>
    
    <main class="mx-auto w-full max-w-5xl flex-1 px-5 py-10 sm:py-14">

        <div class="mb-8">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#b08b45]">
                Your Book Store
            </p>
            <h1 class="mt-2 font-serif text-3xl font-bold sm:text-4xl">
                My Orders
            </h1>
            <p class="mt-2 text-[#68746b]">
                Keep track of your books and order details.
            </p>
        </div>

        <% if (orders.length) { %>
<div class="mb-8 flex flex-wrap gap-3">
    <a href="/cart"
       class="inline-flex items-center gap-2 rounded-xl border border-[#315b43] px-5 py-3 font-semibold text-[#315b43] transition duration-300 hover:bg-[#315b43] hover:text-white">
        ← Back to Cart
    </a>

    <a href="/categories"
       class="inline-flex items-center gap-2 rounded-xl bg-[#315b43] px-5 py-3 font-semibold text-white shadow-sm transition duration-300 hover:bg-[#244832] hover:shadow-md">
        Explore Categories →
    </a>
</div>
            <div class="space-y-4">
                <% orders.forEach(order => { %>

                    <a href="/orders/<%= order._id %>"
                       class="group block rounded-2xl border border-[#e5e2d8] bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-[#bdcdbb] hover:shadow-lg sm:p-6">

                        <div class="flex flex-wrap items-center justify-between gap-4">

                            <div class="flex items-start gap-4">
                                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#edf2e9] text-2xl">
                                    📚
                                </div>

                                <div>
                                    <p class="font-semibold sm:text-lg">
                                        Order
                                        <span class="font-mono text-sm text-[#68746b]">
                                            #<%= String(order._id).slice(-8).toUpperCase() %>
                                        </span>
                                    </p>

                                    <p class="mt-2 text-sm text-[#68746b]">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN') %>
                                        <span class="mx-1">·</span>
                                        <%= order.items.length %> item(s)
                                    </p>
                                </div>
                            </div>

                            <div class="sm:text-right">
                                <p class="text-xl font-bold text-[#315b43]">
                                    ₹<%= Number(order.total).toLocaleString('en-IN') %>
                                </p>

                                <span class="mt-2 inline-block rounded-full bg-[#edf3ed] px-3 py-1 text-xs font-semibold text-[#315b43]">
                                    <%= order.status %>
                                </span>
                            </div>

                        </div>

                        <div class="mt-5 flex items-center justify-between border-t border-[#eeeae1] pt-4">
                            <span class="text-sm text-[#68746b]">Cash on delivery</span>
                            <span class="font-semibold text-[#315b43] transition group-hover:text-[#b08b45]">
                                View Details →
                            </span>
                        </div>

                    </a>

                <% }) %>
            </div>

        <% } else { %>

            <section class="rounded-3xl border border-[#e5e2d8] bg-white px-6 py-12 text-center shadow-sm sm:py-16">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#edf2e9] text-4xl">
                    📖
                </div>

                <h2 class="mt-5 font-serif text-2xl font-bold">
                    No Orders Yet
                </h2>

                <p class="mx-auto mt-2 max-w-sm text-[#68746b]">
                    Your next favorite read is waiting. Explore our collection and find your next book.
                </p>

                <a href="/books"
                   class="mt-6 inline-block rounded-xl bg-[#315b43] px-6 py-3 font-semibold text-white transition hover:bg-[#244832] hover:shadow-md">
                    Browse Books →
                </a>

            </section>

        <% } %>

    </main>

    <footer class="bg-[#1d3025] py-5 text-center text-sm text-white/60">
        Read. Learn. Grow. © The Book Store
    </footer>

</body>
</html>